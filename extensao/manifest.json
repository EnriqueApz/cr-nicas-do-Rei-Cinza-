{
  "manifest_version": 3,
  "name": "Assistente de Combate (pessoal)",
  "version": "0.5.0",
  "description": "Ajuda o mestre nos combates dentro do Roll20.",
  "permissions": [
    "storage",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.roll20.net/editor*"
      ],
      "js": [
        "src/dados/m01c06-tobias.js",
        "src/dados/condicoes.js",
        "src/motor/estado.js",
        "src/motor/taticas.js",
        "src/roll20/chat.js",
        "src/roll20/iniciativa.js",
        "src/roll20/turnos.js",
        "src/ui/armazenamento.js",
        "src/ui/painel.js",
        "src/conteudo.js"
      ],
      "css": [
        "src/ui/painel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.roll20.net/editor*"
      ],
      "js": [
        "src/roll20/ponte-pagina.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ]
}
